<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/departmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_cream"
    android:orientation="vertical">

    <TextView
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/university_department"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/beige_cream"
        android:background="@color/olive_green" />

    <androidx.slidingpanelayout.widget.SlidingPaneLayout
        android:id="@+id/slidingPaneLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- List Fragment Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/listContainer"
            android:name="com.example.exp5.ListFragment"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Detail Fragment Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/detailContainer"
            android:name="com.example.exp5.DetailFragment"
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:layout_weight="2" />

    </androidx.slidingpanelayout.widget.SlidingPaneLayout>

    <TextView
        android:id="@+id/appFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/department_footer"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/beige_cream"
        android:background="@color/olive_green" />
</LinearLayout>